# Konfiguration für scripts/backup-orchestrator.sh (läuft auf dem BACKUP-Server)
# Kopieren nach scripts/backup-orchestrator.env und Werte eintragen.
# Diese Datei NICHT ins Git committen.

# Zielverzeichnis auf dem Backup-Server
BACKUP_DIR=/var/backups/portal

# Backend-Server (Datenbank + Speicher)
DB_HOST=190.97.167.123
DB_CONTAINER=supabase-db
SUPABASE_DIR=/opt/supabase

# Weitere Server (leer lassen, wenn nicht vorhanden)
SERVER_PORTAL_HOST=190.97.167.124
SERVER_LANDING_HOST=
SERVER_BOT_HOST=
SERVER_WEBID_HOST=

# Aufbewahrung
BACKUP_RETENTION_DAYS=14
BACKUP_MONTHLY_RETENTION_DAYS=92

# Verschlüsselung (dringend empfohlen). Schlüssel erzeugen:  age-keygen -o key.txt
# Öffentlichen Schlüssel (age1...) hier eintragen. key.txt in den Passwortmanager
# und danach vom Server LÖSCHEN — er wird nur beim Restore gebraucht.
AGE_PUBLIC_KEY=

# Prüfgrenzen
MIN_ARCHIVE_MB=50
MIN_PUBLIC_TABLES=20
MAX_BACKUP_AGE_HOURS=12
DISK_ALERT_PERCENT=80

# Alarm per Telegram (Bot bei @BotFather anlegen, Chat-ID über @userinfobot)
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=
# und/oder per E-Mail (benötigt ein eingerichtetes "mail"-Programm)
ALERT_EMAIL=

# Optional: zweite Kopie außer Haus, z. B. Hetzner Storage Box
# OFFSITE_RSYNC_TARGET=u123456@u123456.your-storagebox.de:portal
# OFFSITE_SSH_OPTS=-p 23
OFFSITE_RSYNC_TARGET=
OFFSITE_SSH_OPTS=
